+           strstr(p->row->areas[1].template_, "{extdata_id}") != NULL;
+}
+
+static bool ctr_save_id(char *id, size_t cap) {
+    char flat[17];
+    size_t n = 0;
+    for (const char *c = id; *c; c++) {
+        if (*c == '/' && c == id + 8 && strlen(id) == 17) continue;
+        if (!isxdigit((unsigned char)*c) || n == 16) return false;
+        flat[n++] = (char)tolower((unsigned char)*c);
+    }
+    if (n != 8 && n != 16) return false;
+    flat[n] = '\0';
+    return snprintf(id, cap, "%.*s/%s", 8, n == 8 ? "00040000" : flat, n == 8 ? flat : flat + 8) < (int)cap;
+}
+
+static void extdata_id_of(const sigil_profile_root *p, char out[16]) {
+    out[0] = '\0';
+    if (!ctr_layout(p)) return;
+    static const struct { const char *title; const char *extdata; } native_ids[] = {
+        { "00040000/00055e00", "0000055d" },
+        { "00040000/0011c400", "000011c5" },
+        { "00040000/001b5100", "00001b50" },
+        { "00040000/0008d300", "" },
+    };
+    for (size_t i = 0; i < sizeof(native_ids) / sizeof(native_ids[0]); i++) {
+        if (strcmp(p->save_id, native_ids[i].title) == 0) {
+            snprintf(out, 16, "%s", native_ids[i].extdata);
+            return;
+        }
     }
-    snprintf(out, 16, "%08lx", value >> 8);
+    const char *low = strrchr(p->save_id, '/');
+    if (low) snprintf(out, 16, "%08lx", strtoul(low + 1, NULL, 16) >> 8);
 }
 

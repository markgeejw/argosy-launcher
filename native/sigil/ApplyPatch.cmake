set(ARGOSY_SIGIL_PATCH_DIR "${CMAKE_CURRENT_LIST_DIR}")

function(argosy_patch_sigil)
    set(source_dir "${ARGOSY_SIGIL_PATCH_DIR}/../../sigil")
    set(overlay "${CMAKE_CURRENT_BINARY_DIR}/argosy-sigil-patched")
    set(files save_profiles save_layout sync_profiles)
    set(hashes
        e3d23a536796587786cdde6817abb84aa1d5d122a80b98b4829f6411aa36492e
        b1c408b1f6ee32c161cd184e9f5abbcaafd1e9c8e42f3e11087987a97080af2b
        e427a0db6c51307225dd54253bdbf6f0335ecbcbd3b1b24bfd4cd01552f04c1d)
    file(MAKE_DIRECTORY "${overlay}/src")
    foreach(index RANGE 0 2)
        list(GET files ${index} name)
        list(GET hashes ${index} expected)
        file(SHA256 "${source_dir}/src/${name}.c" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Sigil ${name}.c differs from pinned 794d99fe271d034960b67d71d0833064bb665fa9")
        endif()
        configure_file("${source_dir}/src/${name}.c" "${overlay}/src/${name}.c" COPYONLY)
    endforeach()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ARGOSY_SIGIL_PATCH_DIR}/3ds-extdata.patch")
    find_program(ARGOSY_GIT git REQUIRED)
    execute_process(
        COMMAND "${ARGOSY_GIT}" apply --unsafe-paths "--directory=${overlay}" "${ARGOSY_SIGIL_PATCH_DIR}/3ds-extdata.patch"
        WORKING_DIRECTORY "${overlay}"
        RESULT_VARIABLE patch_result ERROR_VARIABLE patch_error)
    if(NOT patch_result EQUAL 0)
        message(FATAL_ERROR "Sigil patch failed: ${patch_error}")
    endif()
    get_target_property(sources sigil SOURCES)
    get_target_property(original_dir sigil SOURCE_DIR)
    set(patched_sources)
    foreach(source IN LISTS sources)
        get_filename_component(name "${source}" NAME_WE)
        if(name IN_LIST files)
            list(APPEND patched_sources "${overlay}/src/${name}.c")
        elseif(IS_ABSOLUTE "${source}")
            list(APPEND patched_sources "${source}")
        else()
            list(APPEND patched_sources "${original_dir}/${source}")
        endif()
    endforeach()
    set_property(TARGET sigil PROPERTY SOURCES "${patched_sources}")
    target_include_directories(sigil PRIVATE "${source_dir}/src")
endfunction()
